# OS files
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/

# MkDocs build output (mkdocs.yml)
site/

# Application build directories (BUILD.md: cmake -S app -B build/app)
build/

# The backup the application keeps of a project when it saves one
# (app/src/core/project/project_store.h: kBackupSuffix)
*~

# The hardware investigation, removed from the repository; older clones
# still hold its local-only captures, PROM images and builds
/investigation/

# The commit the Flatpak reports, written by the release workflow
# (app/packaging/flatpak/io.github.simoninns.speak5220.yml)
app/packaging/flatpak/version

# nix build's links to its outputs in the Nix store (result, result-*)
/result
/result-*

# Written by the dev shell's git-hooks.nix setup (flake.nix); a link into the Nix store
.pre-commit-config.yaml

# Local copies of copyrighted reference texts, code and ROM sets (for
# example MAME's BBC Micro ROMs) and the encoder's test corpus
# (app/scripts/fetch-corpus.sh), used but never committed.
local/
