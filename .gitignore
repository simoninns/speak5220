# KiCad temporary and backup files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# KiCad local history
.history/

# Netlist and BOM files
*.net
*.dsn
*.ses

# Exported manufacturing output
gerbers/
production/

# OS files
.DS_Store
Thumbs.db

# Firmware build output
firmware/build/

# Captures (docs-tech/speech_capture_plan.md, section 6): evidence captures
# commit their raw data only as raw/scope_raw.npz.zip; PROM corpus captures
# are kept local for now, apart from each PROM's index and take lists
captures/corpus/*
!captures/corpus/*/
captures/corpus/*/*
!captures/corpus/*/index.md
!captures/corpus/*/prom.json
!captures/corpus/*/takes.csv
!captures/corpus/*/sweep.csv
# Phase 8 vector captures (tools/vectors.py) are kept local in the same
# way; their sets' definitions are in captures/phase8/vectors/
captures/vectors/*
!captures/vectors/*/
captures/vectors/*/*
!captures/vectors/*/index.md
!captures/vectors/*/takes.csv
captures/vectors/experiments/
# The same vector sets captured on chip 4 (datasheet section 8.8)
captures/vectors_chip4/*
!captures/vectors_chip4/*/
captures/vectors_chip4/*/*
!captures/vectors_chip4/*/index.md
!captures/vectors_chip4/*/takes.csv
captures/**/raw/*.npz
captures/**/dac_step_response.npy

# PROM images that may not be redistributed (plan section 11); their
# manifests in proms/ record the hashes
proms/images/

# Python bytecode
__pycache__/

# Local, not for the repository: third-party code built for comparison
# (MAME's TMS5220, local/mame5220/) and its outputs
local/
