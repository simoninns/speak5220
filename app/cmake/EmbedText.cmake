# Writes a text file into a header as a string constant, in script mode:
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DGUARD=<macro>
#         -DNAMESPACE=<namespace> -DNAME=<constant> -P EmbedText.cmake
# The text is held in a raw string literal, so it must not contain the
# delimiter )text". The BBC Micro disc's player program is built in this
# way from app/src/core/bbc/speak.bas.

file(READ "${INPUT}" _text)
string(FIND "${_text}" ")text\"" _delimiter)
if(NOT _delimiter EQUAL -1)
    message(FATAL_ERROR "${INPUT} contains the raw string delimiter )text\"")
endif()
set(_content
    "// Generated by app/cmake/EmbedText.cmake from ${INPUT}. Do not edit.
#ifndef ${GUARD}
#define ${GUARD}
#include <string_view>
namespace ${NAMESPACE} {
inline constexpr std::string_view ${NAME} = R\"text(${_text})text\";
}  // namespace ${NAMESPACE}
#endif  // ${GUARD}
"
)
file(WRITE "${OUTPUT}" "${_content}")
